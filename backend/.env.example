# AWS Configuration
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1

# Amazon Bedrock
BEDROCK_MODEL_ID=google.gemma-3-12b-it
BEDROCK_REGION=us-east-1

# DynamoDB Tables
DYNAMODB_REGION=us-east-1
DYNAMODB_TABLE=StudyTwinPredictions
DYNAMODB_USERS_TABLE=EduLearnUsers
DYNAMODB_FEEDBACK_TABLE=EduLearnFeedback
DYNAMODB_TABLE_COURSES=EduLearnCourses
DYNAMODB_TABLE_MODULES=EduLearnModules
DYNAMODB_TABLE_LESSONS=EduLearnLessons
DYNAMODB_TABLE_COURSE_SELECTIONS=EduLearnCourseSelections

# S3 Storage
S3_BUCKET_NAME=edulearn-books-storage
S3_REGION=ap-south-1
VIDEOS_S3_BUCKET=edulearn-books-storage
VIDEOS_S3_REGION=ap-south-1

# Server & Client Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
